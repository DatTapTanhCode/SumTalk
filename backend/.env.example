# Copy to .env to override defaults (see app/config.py for every option).

# Whisper model: auto | tiny | base | small | medium | large-v3 | large-v3-turbo
#   auto = large-v3-turbo on an NVIDIA GPU, small on CPU. On a slow CPU try base.
WHISPER_MODEL=auto
# auto | cuda | cpu   (GPU needs: pip install -r requirements-gpu.txt)
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ---- Speech-to-text engine ----
# local  = Whisper on this machine (downloads ~0.5-1.6 GB once; fast with an NVIDIA GPU).
# remote = an OpenAI-compatible transcription API - nothing is downloaded here:
#   a SumTalk server with a GPU:  STT_BASE_URL=https://<server>/v1   STT_API_KEY=<one of its STT_SERVER_API_KEYS>
#   Groq:                         STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3-turbo
#   OpenAI:                       STT_BASE_URL=https://api.openai.com/v1        STT_MODEL=whisper-1
STT_PROVIDER=local
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# Parallel requests for long files, and audio per request (cut at pauses).
STT_CONCURRENCY=4
STT_BLOCK_SEC=30
# Let desktop apps / other installs use THIS server's Whisper through /v1 (comma-separated keys, empty = off).
STT_SERVER_API_KEYS=

# Live transcription while recording, then an accurate pass over the whole file when it stops.
LIVE_TRANSCRIPTION=true
FINAL_PASS=true
# Recorder chunk length (s) and the minimum time between live passes (2 is gentler on paid APIs).
CHUNK_SECONDS=1
LIVE_INTERVAL_SEC=0
# Long files are transcribed in sections of this many seconds, cut at a quiet moment.
LONG_SECTION_SEC=300

# Upload limits
MAX_UPLOAD_MB=1024

# ---- LLM for summary + translation (Sprint 3) ----
# Any OpenAI-compatible endpoint. Local Ollama: install it, `ollama pull <model>`, keep the URL below.
# Cloud provider: put its OpenAI-compatible base URL and API key (never commit backend/.env).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Model chosen from the Sprint 2 benchmark - change it here if the team picks another one.
SUMMARY_MODEL=gemma4:26b-a4b
TRANSLATION_MODEL=gemma4:26b-a4b
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2
# Estimated USD per 1M tokens, only used to log the cost of each run (0 = local model).
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
# Transcripts longer than this are summarized in parts, then merged (map-reduce).
SUMMARY_CHUNK_CHARS=12000
TRANSLATION_BATCH_SEGMENTS=20
DEFAULT_SUMMARY_LANGUAGE=vi
SUMMARY_LANGUAGES=["vi","en"]
TRANSLATION_LANGUAGES=["vi","en"]
# A failed summary/translation job is retried this many times, and stopped after the time limit.
AI_JOB_RETRIES=2
AI_JOB_TIME_LIMIT_SEC=1800
# true = fake model with fixed answers (CI, demos, machines without a model). No network calls.
AI_MOCK=false
