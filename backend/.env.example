# Copy to .env to override defaults (see app/config.py for every option).

# Whisper model: auto | tiny | base | small | medium | large-v3 | large-v3-turbo
#   auto = large-v3-turbo on an NVIDIA GPU, small on CPU. On a slow CPU try base.
WHISPER_MODEL=auto
# auto | cuda | cpu   (GPU needs: pip install -r requirements-gpu.txt)
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Live transcription while recording, then an accurate pass over the whole file when it stops.
LIVE_TRANSCRIPTION=true
FINAL_PASS=true

# Upload limits
MAX_UPLOAD_MB=1024
