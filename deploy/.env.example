# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Used by docker compose (SITE_ADDRESS, BASIC_AUTH_*, GPU) and passed to the app (everything else).

# ---- Address + login (Caddy) ----
# A domain pointing at the Elastic IP, or <ip-with-dashes>.sslip.io, e.g. 13-229-10-20.sslip.io
SITE_ADDRESS=sumtalk.example.com
BASIC_AUTH_USER=sumtalk
# docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# ---- Instance type ----
# 0 = CPU instance (use STT_PROVIDER=remote below, or a small local model); 1 = GPU instance (also use
# docker-compose.gpu.yml)
GPU=0

# ---- Speech-to-text ----
# CPU instance: a hosted Whisper API (nothing to download, fast).
STT_PROVIDER=remote
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# Paid APIs: space live passes out a little.
LIVE_INTERVAL_SEC=1.5
# GPU instance instead: local Whisper large-v3-turbo (downloaded once into the data volume, 1.6 GB):
# STT_PROVIDER=local
# WHISPER_MODEL=auto
# ...and let desktop apps use this server as their engine (comma-separated keys, empty = off):
STT_SERVER_API_KEYS=

# ---- Storage on S3 (bucket in the same region; the EC2 instance role gives access) ----
STORAGE_BACKEND=s3
S3_BUCKET=sumtalk-audio-yourteam
S3_PREFIX=sumtalk/
S3_REGION=ap-southeast-1
S3_DB_BACKUP_HOURS=6

# ---- Summary + translation (OpenAI-compatible LLM) ----
# AI_MOCK=true shows fixed demo answers without any model.
AI_MOCK=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
SUMMARY_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini

# ---- Limits ----
MAX_UPLOAD_MB=1024
